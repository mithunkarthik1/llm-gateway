# =====================================================================
# Enterprise LLM Gateway & RAG Configuration (Example Template)
# =====================================================================

# Server Settings
PORT=8000
HOST=0.0.0.0

# Groq Gateway LLM Configuration
DEFAULT_GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODELS_URL=https://api.groq.com/openai/v1/models

# RAG LLM Settings
RAG_LLM_MODEL=llama-3.3-70b-versatile
RAG_LLM_PRIORITY_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,allam-2-7b,openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
RAG_ONLY_MODE=true

# Local Embedding Model & FAISS Parameters
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
FAISS_TOP_K=1
FAISS_SIMILARITY_THRESHOLD=0.20
DOMAINS_DATA_FOLDER=domains
# Vector Database Backends (ChromaDB + FAISS Dual Support)
VECTOR_DB_BACKEND=both
CHROMA_DATA_FOLDER=chroma_db
CHROMA_COLLECTION_NAME=nexus_erp_knowledge
FAISS_INDEX_FOLDER=faiss_index

# PostgreSQL Knowledge Base (Primary Source of Truth)
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_nexus_rag
DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
USE_POSTGRES_KB=true
